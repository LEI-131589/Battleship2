<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- 131589 - Gonçalo Gonçalves -->
<module name="Checker">
    <property name="severity" value="error"/>
    <module name="TreeWalker">
        <!-- Regra para garantir que as constantes estão em UPPER_SNAKE_CASE -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
            <message key="name.invalidPattern" value="O nome da constante ''{0}'' deve estar em MAIÚSCULAS separadas por sublinhados (ex: MAX_VALOR)."/>
        </module>
    </module>
</module>